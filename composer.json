{
  "name": "syntaxphoenix/monolog-opensearch-handler",
  "description": "OpenSearch handler for Monolog",
  "license": "MIT",
  "require": {
    "monolog/monolog": "^2.0.0",
    "opensearch-project/opensearch-php": "^2.2.0",
    "symfony/http-client": "^6.0|^7.0",
    "nyholm/psr7": "^1.8"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.2.1"
  },
  "autoload": {
    "psr-4": {
      "SyntaxPhoenix\\MonologOpenSearchHandler\\": "src/"
    }
  },
  "scripts": {
    "test": "phpunit tests --testdox --colors"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": false
    }
  }
}
